# /etc/fast-street/api.env — configuração PRIVADA da Fast Street API em produção.
# Permissões: sudo chown root:faststreet /etc/fast-street/api.env && sudo chmod 640 /etc/fast-street/api.env
# NUNCA versionar o arquivo real. Valores reais ficam no cofre de senhas (KeePassXC).
# NODE_ENV, HOST, PORT e UPLOAD_DIR são definidos na unidade systemd (fast-street-api.service).

# Usuário próprio da aplicação, só com acesso ao banco fast_street, conectando pelo loopback.
DATABASE_URL=mysql://fast_street:VALOR_OCULTADO@127.0.0.1:3306/fast_street

# openssl rand -base64 48   (a API recusa subir com o valor de exemplo)
JWT_SECRET=VALOR_OCULTADO

# Endereço público (link do e-mail de confirmação e URLs das fotos).
PUBLIC_API_URL=https://faststreet.duckdns.org

CORS_ORIGINS=
DB_LOCK_WAIT_TIMEOUT=30

# Sem SMTP_HOST o e-mail é simulado: o link de confirmação aparece em journalctl -u fast-street-api.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM="Fast Street <nao-responda@faststreet.dev>"
