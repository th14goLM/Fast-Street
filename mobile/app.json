{
  "expo": {
    "name": "Fast Street",
    "slug": "fast-street",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A2730",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A2730",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Fast Street usa suas fotos para a foto de perfil e as fotos dos seus veículos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Para mostrar eventos e parceiros perto de você. Sua posição nunca aparece para outros usuários."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E95D2C"
        }
      ]
    ],
    "scheme": "faststreet",
    "backgroundColor": "#1A2730"
  }
}
