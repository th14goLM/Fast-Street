# Variáveis do docker-compose.prod.yml. No servidor: cp deploy/env.prod.example .env
# O .env NÃO vai para o git. Use senhas longas SÓ com letras e números (vão dentro da URL do banco):
#   openssl rand -hex 24

MYSQL_ROOT_PASSWORD=troque-por-openssl-rand-hex-24
MYSQL_DATABASE=fast_street
MYSQL_USER=fast_street
MYSQL_PASSWORD=troque-por-outra-openssl-rand-hex-24

# Endereço atendido pelo Caddy:
#   :80                          acesso por IP, sem HTTPS (apenas testes)
#   api.<ip-com-hífens>.sslip.io  HTTPS grátis sem domínio próprio (ex.: api.18-231-10-5.sslip.io)
#   api.seudominio.com.br        domínio próprio apontando para o IP elástico da instância
SITE_ADDRESS=:80
