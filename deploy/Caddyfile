# Proxy reverso da Fast Street API.
# SITE_ADDRESS vem do .env: ":80" (acesso por IP) ou um domínio, que recebe HTTPS automático (Let's Encrypt).
{$SITE_ADDRESS::80} {
	encode gzip

	# Uploads aceitam até 1 MB por imagem; o restante da API, 32 KB.
	request_body {
		max_size 2MB
	}

	reverse_proxy api:3333

	header {
		-Server
	}

	log {
		output stdout
		format console
	}
}
