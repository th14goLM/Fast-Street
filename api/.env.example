# Copie para .env e ajuste.
NODE_ENV=development
PORT=3333

# MySQL 8. Escolha UMA das linhas:
# - MySQL instalado no computador (ex.: Workbench), porta 3306:
DATABASE_URL=mysql://root:SUA_SENHA@127.0.0.1:3306/fast_street
# - MySQL do Docker: usuário, senha e porta iguais aos do .env da RAIZ (MYSQL_USER, MYSQL_PASSWORD, MYSQL_PORT):
# DATABASE_URL=mysql://fast_street:troque-esta-senha@127.0.0.1:3307/fast_street

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# URL pública da API, usada para montar o link de verificação de e-mail.
# No celular físico, use o IP da sua máquina na rede (ex.: http://192.168.0.10:3333).
PUBLIC_API_URL=http://localhost:3333

# Origens liberadas no CORS (separe por vírgula). Vazio = todas (apenas em desenvolvimento).
CORS_ORIGINS=

# Pasta onde ficam as fotos enviadas (perfil e veículos), relativa à pasta api/.
# Em produção, troque o armazenamento em src/shared/storage.ts por S3/Cloudinary.
UPLOAD_DIR=uploads

# ── E-mail (verificação de conta) ─────────────────────────────────────────────
# Sem SMTP_HOST, o e-mail é simulado: o link aparece no terminal da API.
# Mailtrap (desenvolvimento): mailtrap.io → Email Testing → Inboxes → sua inbox →
# Integration "SMTP" → copie Host, Port, Username e Password para cá.
# Os e-mails chegam na caixa de teste do Mailtrap, nunca na caixa real do usuário.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
# Só "true" para a porta 465 (TLS direto). Deixe vazio nas portas 587/2525.
SMTP_SECURE=
MAIL_FROM="Fast Street <nao-responda@faststreet.dev>"
