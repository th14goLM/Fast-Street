# Copie para .env e ajuste.
NODE_ENV=development
PORT=3333

# MySQL 8 (veja docker-compose.yml na raiz do repositório)
DATABASE_URL=mysql://fast_street:fast_street@localhost:3306/fast_street

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# URL pública da API, usada para montar o link de verificação de e-mail.
# No celular físico, use o IP da sua máquina na rede (ex.: http://192.168.0.10:3333).
PUBLIC_API_URL=http://localhost:3333

# Origens liberadas no CORS (separe por vírgula). Vazio = todas (apenas em desenvolvimento).
CORS_ORIGINS=
