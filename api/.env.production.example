# Configuração da API em produção (servidor EC2). No servidor: cp api/.env.production.example api/.env
# O DATABASE_URL, a porta e a pasta de uploads são definidos pelo docker-compose.prod.yml.

# Gere um segredo NOVO para produção (nunca reutilize o do seu computador):
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-novo-com-pelo-menos-32-caracteres

# Endereço público da API (usado no link do e-mail de confirmação).
# Sem domínio: http://<IP-elástico>   Com HTTPS: https://<SITE_ADDRESS do .env>
PUBLIC_API_URL=http://SEU-IP-ELASTICO

# O app mobile não usa CORS; deixe vazio, a menos que uma página web consuma a API.
CORS_ORIGINS=

# Tempo máximo de espera por bloqueio no migrate (segundos).
DB_LOCK_WAIT_TIMEOUT=30

# E-mail. Sem SMTP_HOST, o link de confirmação só aparece no log da API (docker compose logs api).
# Em testes: caixa de testes do Mailtrap (porta 2525). Em produção real: Amazon SES, Resend ou Brevo.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM="Fast Street <nao-responda@faststreet.dev>"
