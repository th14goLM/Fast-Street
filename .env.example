# Parâmetros do MySQL do Docker (docker-compose.yml). Copie para .env e troque as senhas.
# O .env NÃO vai para o git. A API tem o próprio arquivo: api/.env.
#
# Atenção: as senhas só valem na PRIMEIRA vez que o contêiner cria o banco.
# Para mudar depois: docker compose down -v (APAGA o banco do Docker) e docker compose up -d.

MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_DATABASE=fast_street
MYSQL_USER=fast_street
MYSQL_PASSWORD=troque-esta-senha

# Porta no seu computador. 3307 evita conflito com um MySQL já instalado (que usa a 3306).
MYSQL_PORT=3307
